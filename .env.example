# Optional: enables the /clerk/* pages
VITE_CLERK_PUBLISHABLE_KEY=
# Live mode: read SLAs, proofs and KPIs from the ZK-SLA api-gateway (Shaker-Genopole/services)
VITE_LIVE_API=false
# API origin for local development (the container image proxies /api, so leave empty there)
VITE_API_URL=http://localhost:8080
# Sui network for wallet connections and on-chain agreements
VITE_SUI_NETWORK=testnet
# From contracts/scripts/deploy.sh (deployment.<network>.json)
VITE_SUI_PACKAGE_ID=
VITE_SUI_VERIFIER_REGISTRY_ID=
